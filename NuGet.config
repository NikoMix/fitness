<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Forge package sources.

    DevExpress .NET MAUI controls (DevExpress.Maui.*) are published to nuget.org and are
    free to use. They are pinned in Directory.Packages.props to 26.1.4 so that the version
    matches the DevExpress 26.1 installation on the development machine.

    "DevExpress 26.1 Local" is the offline feed created by the local DevExpress installer.
    It carries the non-MAUI DevExpress product packages (Charts.Core, Drawing, Pdf, ...).
    It is declared here so restore succeeds on machines that have it, and it is tolerated
    as missing on machines (such as CI runners) that do not - see the fallback note below.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <add key="globalPackagesFolder" value="%USERPROFILE%\.nuget\packages" />
  </config>
</configuration>
