## .NET / Visual Studio
bin/
obj/
# NOTE: do not add bare "[Dd]ebug/" or "[Rr]elease/" here. Those patterns match ANY directory
# with that name at any depth, so they silently excluded docs/release/ and tools/release/ -
# the entire release runbook and release pipeline tooling - from the repository. Nothing was
# reported: git add -A simply skipped them. Build output for those configurations already
# lives under bin/, obj/ and artifacts/, so anchoring the patterns loses nothing. The same
# trap is latent in "[Rr]eleases/" below; leave it unless a real docs/releases/ appears.
[Bb]in/[Dd]ebug/
[Bb]in/[Rr]elease/
[Oo]bj/[Dd]ebug/
[Oo]bj/[Rr]elease/
x64/
x86/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
[Ll]og/
[Ll]ogs/
artifacts/
.vs/
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser
*.svclog
*.psess
*.vsp
*.vspx
*.sap
project.lock.json
project.fragment.lock.json
*.nuget.props
*.nuget.targets

