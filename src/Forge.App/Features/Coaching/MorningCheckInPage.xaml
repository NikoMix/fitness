<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Coaching.MorningCheckInPage"
             Title="Morning check-in"
             BackgroundColor="{dx:ThemeColor Surface}">
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             HorizontalOptions="Center"
                             WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ReadingWidth}" Spacing="{StaticResource SpaceL}">
            <Label Text="Morning check-in" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Rate each manual input from 1 to 5. Sleep can be manual or health-store sourced when available." Style="{StaticResource SecondaryText}" />

            <controls:ForgeCard Title="Subjective recovery" Subtitle="Manual-first and local">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <!--
                        Each field carries its own description. The visible label above it is left
                        out of the accessibility tree so a screen reader announces "Energy, edit
                        box" once rather than "Energy" and then an unnamed control.
                    -->
                    <Label Text="Energy" Style="{StaticResource TitleText}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <dx:NumericEdit Value="{Binding Energy}"
                                    SemanticProperties.Description="Energy"
                                    SemanticProperties.Hint="Rate from 1 to 5"
                                    Style="{StaticResource ForgeNumericEdit}" />
                    <Label Text="Soreness" Style="{StaticResource TitleText}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <dx:NumericEdit Value="{Binding Soreness}"
                                    SemanticProperties.Description="Soreness"
                                    SemanticProperties.Hint="Rate from 1 to 5"
                                    Style="{StaticResource ForgeNumericEdit}" />
                    <Label Text="Motivation" Style="{StaticResource TitleText}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <dx:NumericEdit Value="{Binding Motivation}"
                                    SemanticProperties.Description="Motivation"
                                    SemanticProperties.Hint="Rate from 1 to 5"
                                    Style="{StaticResource ForgeNumericEdit}" />
                    <Label Text="Stress" Style="{StaticResource TitleText}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <dx:NumericEdit Value="{Binding Stress}"
                                    SemanticProperties.Description="Stress"
                                    SemanticProperties.Hint="Rate from 1 to 5"
                                    Style="{StaticResource ForgeNumericEdit}" />
                    <Label Text="Sleep hours (optional)" Style="{StaticResource TitleText}"
                           AutomationProperties.IsInAccessibleTree="False" />
                    <dx:NumericEdit Value="{Binding SleepHours}"
                                    SemanticProperties.Description="Sleep hours, optional"
                                    Style="{StaticResource ForgeNumericEdit}" />
                    <dx:DXButton Content="Save check-in"
                                 SemanticProperties.Description="Save check-in"
                                 Style="{StaticResource PrimaryButton}"
                                 Command="{Binding SaveCommand}" />
                    <Label Text="{Binding SaveStatus}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>
            </controls:ForgeCard>
        </VerticalStackLayout>
    </ScrollView>
    </adaptive:AdaptiveHost>
</ContentPage>
