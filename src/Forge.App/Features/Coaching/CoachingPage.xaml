<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Coaching.CoachingPage"
             Title="Coaching"
             BackgroundColor="{dx:ThemeColor Surface}">
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             HorizontalOptions="Center"
                             WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ContentWidth}" Spacing="{StaticResource SpaceL}">
            <Label Text="Next session" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Deterministic, explainable and overridable coaching that stays on device." Style="{StaticResource SecondaryText}" />
            <dx:DXButton Content="Load recommendation"
    SemanticProperties.Description="Load recommendation" Style="{StaticResource PrimaryButton}" Command="{Binding LoadRecommendationCommand}" />

            <controls:ForgeCard Title="Recommendation" Subtitle="{Binding Status}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="{Binding Load}" Style="{StaticResource HeadlineText}" />
                    <Label Text="{Binding Reps}" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding Explanation}" Style="{StaticResource BodyText}" />
                    <!--
                        What Forge made of the declared limitation, stated whether or not it
                        understood any of it. Onboarding already echoed the sentence back, so
                        silence here would read as agreement.
                    -->
                    <Label Text="{Binding LimitationSummary}"
                           IsVisible="{Binding HasLimitationSummary}"
                           Style="{StaticResource BodyText}"
                           TextColor="{dx:ThemeColor OnSurfaceVariant}" />
                    <Label Text="Forge maps whole movement patterns, not individual movements, and it is not a clinician."
                           IsVisible="{Binding HasUninterpretedLimitation}"
                           Style="{StaticResource CaptionText}" />
                    <Label Text="{Binding MedicalDisclaimer}" Style="{StaticResource CaptionText}" />
                    <dx:DXButton Content="Override recommendation"
    SemanticProperties.Description="Override recommendation" IsVisible="{Binding IsOverrideVisible}" Style="{StaticResource SecondaryButton}" Command="{Binding OverrideCommand}" />
                    <Label Text="{Binding OverrideNote}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>
            </controls:ForgeCard>
        </VerticalStackLayout>
    </ScrollView>
    </adaptive:AdaptiveHost>
</ContentPage>
