<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Onboarding.GoalWizardPage"
             x:Name="Page"
             Title="Goal setup"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        The Shell navigation bar is hidden and the page draws its own header.

        Forge shows exactly one title per page. Here the navigation bar cannot be the one, because
        its back button would pop the whole wizard while the user expects to return to the previous
        step - so back is owned in-page and the hardware back key is routed to the same command.
    -->
    <Grid RowDefinitions="Auto,*,Auto">
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource SpaceM}">
            <controls:PageHeader Title="{Binding StepTitle}"
                                 Subtitle="{Binding StepDescription}"
                                 BackText="{Binding BackActionText}"
                                 BackCommand="{Binding BackCommand}" />
            <controls:StepProgressIndicator StepCount="{Binding StepCount}"
                                            CurrentStep="{Binding StepNumber}"
                                            StepTitle="{Binding StepTitle}" />
        </VerticalStackLayout>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="StepHost"
                                 Padding="{StaticResource PagePadding}"
                                 Spacing="{StaticResource SpaceL}">

                <!-- Step 1: goal -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsGoalStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <dx:TextEdit Text="{Binding DisplayName}"
                                     LabelText="What should Forge call you?"
                                     PlaceholderText="Optional"
                                     SemanticProperties.Description="Display name"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <Label Text="Primary goal" Style="{StaticResource SecondaryText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding Goals}"
                                         SelectedItem="{Binding SelectedGoal}"
                                         PlaceholderText="Choose a goal"
                                         SemanticProperties.Description="Primary goal"
                                         Style="{StaticResource ForgeTextEdit}" />
                        <dx:NumericEdit Value="{Binding TargetWeightKilograms}"
                                        LabelText="Target weight (kg)"
                                        IsVisible="{Binding ShowsWeightTarget}"
                                        SemanticProperties.Description="Target weight in kilograms"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <dx:NumericEdit Value="{Binding TimeframeWeeks}"
                                        LabelText="Timeframe (weeks)"
                                        IsVisible="{Binding ShowsWeightTarget}"
                                        SemanticProperties.Description="Goal timeframe in weeks"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <Label Text="Strength and general-fitness goals do not use a weight target, so Forge does not ask for one."
                               Style="{StaticResource CaptionText}"
                               IsVisible="{Binding ShowsWeightTargetHint}" />
                    </VerticalStackLayout>
                </dx:DXBorder>

                <!-- Step 2: body metrics -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsBodyMetricsStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <dx:NumericEdit Value="{Binding CurrentWeightKilograms}"
                                        LabelText="Current weight (kg)"
                                        SemanticProperties.Description="Current weight in kilograms"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <dx:NumericEdit Value="{Binding HeightCentimetres}"
                                        LabelText="Height (cm)"
                                        SemanticProperties.Description="Height in centimetres"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <dx:NumericEdit Value="{Binding TargetDailyCalories}"
                                        LabelText="Daily energy target (kcal, optional)"
                                        SemanticProperties.Description="Daily energy target in kilocalories, optional"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <Label Text="Leave the energy target at zero if you do not want one. Forge treats zero as &quot;not set&quot; rather than as a target of no food."
                               Style="{StaticResource CaptionText}" />
                        <dx:CheckEdit Label="Share my date of birth"
                                      IsChecked="{Binding SharesDateOfBirth}"
                                      SemanticProperties.Description="Share my date of birth"
                                      SemanticProperties.Hint="Used only by age-based energy formulas" />
                        <dx:DateEdit Date="{Binding DateOfBirth}"
                                     LabelText="Date of birth"
                                     IsVisible="{Binding SharesDateOfBirth}"
                                     SemanticProperties.Description="Date of birth"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <Label Text="Sex, used only where physiology formulas need it" Style="{StaticResource SecondaryText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding SexOptions}"
                                         SelectedItem="{Binding SelectedSex}"
                                         SemanticProperties.Description="Biological sex"
                                         Style="{StaticResource ForgeTextEdit}" />
                    </VerticalStackLayout>
                </dx:DXBorder>

                <!-- Step 3: experience -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsExperienceStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <Label Text="Training background" Style="{StaticResource SecondaryText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding ExperienceLevels}"
                                         SelectedItem="{Binding SelectedExperience}"
                                         PlaceholderText="Choose a level"
                                         SemanticProperties.Description="Training background"
                                         Style="{StaticResource ForgeTextEdit}" />
                        <Label Text="Beginner is the safe choice if you are returning after a break. Forge raises difficulty from what you actually log, not from what you claim here."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                </dx:DXBorder>

                <!-- Step 4: equipment -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsEquipmentStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <dx:CheckEdit Label="Bodyweight" IsChecked="{Binding HasBodyweight}" SemanticProperties.Description="Bodyweight available" />
                        <dx:CheckEdit Label="Dumbbells" IsChecked="{Binding HasDumbbells}" SemanticProperties.Description="Dumbbells available" />
                        <dx:CheckEdit Label="Barbell" IsChecked="{Binding HasBarbell}" SemanticProperties.Description="Barbell available" />
                        <dx:CheckEdit Label="Machines" IsChecked="{Binding HasMachines}" SemanticProperties.Description="Machines available" />
                        <dx:CheckEdit Label="Bands" IsChecked="{Binding HasBands}" SemanticProperties.Description="Resistance bands available" />
                        <dx:TextEdit Text="{Binding MovementLimitations}"
                                     LabelText="Injuries or movement limits (optional)"
                                     SemanticProperties.Description="Injuries or movement limits, optional"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <Label Text="Anything you note here is used to avoid suggesting movements that would aggravate it. It never leaves this device."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                </dx:DXBorder>

                <!-- Step 5: availability -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsAvailabilityStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <dx:NumericEdit Value="{Binding TrainingDaysPerWeek}"
                                        LabelText="Training days per week"
                                        SemanticProperties.Description="Training days per week"
                                        Style="{StaticResource ForgeNumericEdit}" />
                        <Label Text="Three realistic days beat five aspirational ones. You can change this whenever your week changes."
                               Style="{StaticResource CaptionText}" />
                    </VerticalStackLayout>
                </dx:DXBorder>

                <!-- Step 6: review -->
                <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding IsReviewStep}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceS}"
                                         BindableLayout.ItemsSource="{Binding ReviewLines}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <!--
                                    Every line links back to the step that owns it. Discovering a
                                    wrong answer on a summary and having no way to reach it except
                                    by walking the whole flow again is how a review step becomes
                                    the place people give up.
                                -->
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceS}">
                                    <controls:StatRow Label="{Binding Label}" Value="{Binding Value}" />
                                    <dx:DXButton Grid.Column="1"
                                                 Content="Change"
                                                 SemanticProperties.Description="{Binding Label, StringFormat='Change {0}'}"
                                                 Command="{Binding Source={x:Reference Page}, Path=BindingContext.GoToStepCommand}"
                                                 CommandParameter="{Binding Step}"
                                                 Style="{StaticResource TextButton}" />
                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </dx:DXBorder>

                <controls:AdvisoryPanel IsVisible="{Binding HasValidationMessages}"
                                        Headline="{Binding ValidationHeadline}"
                                        Message="{Binding ValidationSummary}"
                                        Reassurance="Everything you have already entered is kept."
                                        IsBlocking="True" />

                <controls:AdvisoryPanel IsVisible="{Binding HasSafetyAdvisory}"
                                        Headline="{Binding SafetyHeadline}"
                                        Message="{Binding SafetyMessage}"
                                        Signpost="{Binding SafetySignpost}"
                                        Reassurance="{Binding SafetyReassurance}"
                                        IsBlocking="{Binding IsSafetyBlocking}" />

                <controls:SkeletonPlaceholder IsBusy="{Binding IsSaving}" HeightRequest="88" />
            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2"
                             Padding="{StaticResource PagePadding}"
                             Spacing="{StaticResource SpaceS}"
                             BackgroundColor="{dx:ThemeColor SurfaceContainer}">
            <dx:DXButton Content="{Binding PrimaryActionText}"
                         SemanticProperties.Description="{Binding PrimaryActionText}"
                         Command="{Binding ContinueCommand}"
                         Style="{StaticResource PrimaryButton}" />
            <Label Text="Nothing is saved until the final step, and your answers are kept if you leave."
                   Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
