<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Onboarding.WelcomePage"
             Title="Welcome"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        The Shell navigation bar is hidden, so this page has exactly one title: the display heading
        below. That also removes the back button, which had nowhere legitimate to go - dismissing
        this screen would drop the user into the tabs with no profile at all, which is precisely the
        state onboarding exists to resolve. Skipping remains available as an explicit, described
        choice that records a minimal profile.

        The tab bar is hidden for the same reason. While it was visible a first-run user could tap
        straight into Train and bypass setup entirely, ending up with no profile at all - the exact
        outcome the skip path exists to make deliberate and recorded. Focused modes elsewhere
        (ActiveWorkout, RestTimer) already use this pattern.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceXl}">
            <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                <Label Text="Forge works without an account"
                       Style="{StaticResource DisplayText}"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Build a useful training profile in about a minute, or skip and start exploring. Everything stays on this device either way."
                       Style="{StaticResource BodyText}" />
            </VerticalStackLayout>

            <dx:DXBorder Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="No sign-up. No backend. No waiting."
                           Style="{StaticResource TitleText}" />
                    <Label Text="Forge stores your profile, goals and logs locally. An optional app lock can protect the device later, but no credentials are needed to begin."
                           Style="{StaticResource SecondaryText}" />
                    <controls:StatRow Label="Setup takes" Value="About a minute" />
                    <controls:StatRow Label="Steps" Value="Six, with back at every one" />
                    <controls:StatRow Label="Leaving part-way" Value="Keeps your answers" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}" IsVisible="{Binding HasSavedDraft}">
                <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                    <Label Text="You already started" Style="{StaticResource TitleText}" />
                    <Label Text="Forge kept the answers from your last attempt and will reopen on the first step that still needs something."
                           Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXButton Content="{Binding StartActionText}"
                         SemanticProperties.Description="{Binding StartActionText}"
                         SemanticProperties.Hint="Opens goal setup"
                         Command="{Binding StartCommand}"
                         Style="{StaticResource PrimaryButton}" />

            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                <dx:DXButton Content="Skip and use Forge now"
                             SemanticProperties.Description="Skip and use Forge now"
                             SemanticProperties.Hint="Opens the app with a minimal profile that you can complete later"
                             Command="{Binding SkipCommand}"
                             Style="{StaticResource SecondaryButton}" />
                <Label Text="Skipping is fine. Forge will open with empty rings and no plan, and Today will show exactly which answers would fill them in."
                       Style="{StaticResource CaptionText}"
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <controls:SkeletonPlaceholder IsBusy="{Binding IsBusy}"
                                          HeightRequest="88" />
            <controls:EmptyState IsVisible="{Binding HasError}"
                                 Headline="Local storage is still starting"
                                 Message="{Binding ErrorMessage}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
