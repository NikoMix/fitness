<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Insights.BodyMetricsPage"
             Title="Body metrics"
             BackgroundColor="{dx:ThemeColor Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">
            <Label Text="Body metrics" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Weight and measurements are shown as a smoothed trend first, with raw entries available for context." Style="{StaticResource SecondaryText}" />

            <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="260" />

            <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                Glyph="≈"
                                Headline="Add your first body metric"
                                 Message="Forge will default to a visible 7-day moving average so water, food and timing noise do not dominate the chart."
                                 ActionText="Open profile"
                                 ActionCommand="{Binding AddBodyMetricCommand}" />

            <controls:ForgeCard IsVisible="{Binding HasData}" Title="Weight trend" Subtitle="{Binding SmoothingLabel}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <dx:ChartView HeightRequest="260">
                        <dx:ChartView.Series>
                            <dx:LineSeries DisplayName="Smoothed">
                                <dx:LineSeries.Data>
                                    <dx:SeriesDataAdapter DataSource="{Binding Points}" ArgumentDataMember="DateLabel">
                                        <dx:ValueDataMember Type="Value" Member="SmoothedKilograms" />
                                    </dx:SeriesDataAdapter>
                                </dx:LineSeries.Data>
                            </dx:LineSeries>
                            <dx:LineSeries DisplayName="Raw entries">
                                <dx:LineSeries.Data>
                                    <dx:SeriesDataAdapter DataSource="{Binding Points}" ArgumentDataMember="DateLabel">
                                        <dx:ValueDataMember Type="Value" Member="RawKilograms" />
                                    </dx:SeriesDataAdapter>
                                </dx:LineSeries.Data>
                            </dx:LineSeries>
                        </dx:ChartView.Series>
                    </dx:ChartView>
                    <Label Text="{Binding TrendSummary}" Style="{StaticResource SecondaryText}" />
                    <Label Text="{Binding RawSeriesLabel}" Style="{StaticResource CaptionText}" />
                </VerticalStackLayout>
            </controls:ForgeCard>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
