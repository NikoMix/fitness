<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Insights.PersonalRecordsPage"
             Title="Personal records"
             BackgroundColor="{dx:ThemeColor Surface}">
    <Grid Padding="{StaticResource PagePadding}" RowDefinitions="Auto,Auto,*" RowSpacing="{StaticResource SpaceL}">
        <Label Text="Personal records" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
        <Label Grid.Row="1" Text="Records are tied to the exact local set that achieved them." Style="{StaticResource SecondaryText}" />

        <controls:SkeletonPlaceholder Grid.Row="2" IsBusy="{Binding IsLoading}" HeightRequest="260" />

        <controls:EmptyState Grid.Row="2"
                             IsVisible="{Binding IsEmpty}"
                             Glyph="★"
                             Headline="Your first records are waiting"
                             Message="Log working sets and Forge will detect heaviest loads, estimated 1RM, reps at a load, and session-volume records without counting warm-ups."
                             ActionText="Log training"
                             ActionCommand="{Binding LogWorkoutCommand}" />

        <dx:DXCollectionView Grid.Row="2" ItemsSource="{Binding Records}" IsVisible="{Binding HasRecords}">
            <dx:DXCollectionView.ItemTemplate>
                <DataTemplate>
                    <dx:DXBorder Style="{StaticResource ListRow}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <Label Text="{Binding Title}" Style="{StaticResource TitleText}" />
                            <Label Text="{Binding Exercise}" Style="{StaticResource BodyText}" />
                            <Label Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                            <Label Text="{Binding AchievedOn}" Style="{StaticResource CaptionText}" />
                        </VerticalStackLayout>
                    </dx:DXBorder>
                </DataTemplate>
            </dx:DXCollectionView.ItemTemplate>
        </dx:DXCollectionView>
    </Grid>
</ContentPage>
