<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             x:Class="Forge.App.Features.Nutrition.RecipesPage"
             Title="Recipes"
             BackgroundColor="{dx:ThemeColor Surface}">
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <VerticalStackLayout Padding="{StaticResource PagePadding}"
                         HorizontalOptions="Center"
                         WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ReadingWidth}" Spacing="{StaticResource SpaceL}">
        <Label Text="Recipes" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
        <dx:DXBorder Style="{StaticResource EmptyStateCard}">
            <Label Text="Recipe logging is prepared for navigation, with recipe import left for its dedicated story."
                   Style="{StaticResource SecondaryText}" />
        </dx:DXBorder>
    </VerticalStackLayout>
    </adaptive:AdaptiveHost>
</ContentPage>
