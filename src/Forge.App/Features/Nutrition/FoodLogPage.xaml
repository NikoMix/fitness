<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Nutrition.FoodLogPage"
             x:Name="Page"
             Title="Food log"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        Every list here is bounded and given a height so it takes a predictable part of the page.
        That is right while a list has rows and wrong the moment it does not: the height is still
        reserved, and what renders is a container holding nothing, with no text and no description
        for a screen reader to announce. The smoke harness found one - a 975x420 box under
        "Recent" containing two views and no content at all.

        So each section binds its visibility to its own collection, and an empty list now takes its
        heading with it rather than leaving a title over a void. The page-level empty state is what
        explains the situation, and it carries copy precisely so that it is never itself a wordless
        box.
    -->
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             HorizontalOptions="Center"
                             WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ContentWidth}" Spacing="{StaticResource SpaceL}">
            <Label Text="Search and log food" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
            <dx:TextEdit Text="{Binding SearchQuery}"
                         PlaceholderText="Search foods"
                         SemanticProperties.Description="Search foods"
                         SemanticProperties.Hint="Results appear below as you type"
                         Style="{StaticResource ForgeTextEdit}" />

            <dx:DXButton Content="Scan barcode"
                         IsVisible="{Binding CanScanBarcode}"
                         SemanticProperties.Description="Scan a barcode"
                         SemanticProperties.Hint="Opens the camera to look up a packaged food by its barcode"
                         Style="{StaticResource SecondaryButton}"
                         Command="{Binding ScanBarcodeCommand}" />

            <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="96" />

            <controls:EmptyState IsVisible="{Binding HasNoLoggedFoods}"
                                 Glyph="＋"
                                 Headline="No food logged today"
                                 Message="Search the local catalogue or use repeat shortcuts once you have history. Everything stays on this device." />
 
            <VerticalStackLayout Spacing="{StaticResource SpaceS}"
                                 IsVisible="{Binding RecentFoods, Converter={StaticResource HasItems}}">
            <Label Text="Recent" Style="{StaticResource SectionHeaderText}" SemanticProperties.HeadingLevel="Level2" />
            <dx:DXCollectionView ItemsSource="{Binding RecentFoods}"
                                 HeightRequest="160"
                                 ItemSpanCount="{Binding Source={x:Reference Adaptive}, Path=CardColumns}">
                <dx:DXCollectionView.ItemTemplate>
                    <DataTemplate>
                         <dx:DXBorder Style="{StaticResource ListRow}">
                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                 <VerticalStackLayout>
                                     <Label Text="{Binding Name}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                     <Label Text="{Binding Nutrition}" Style="{StaticResource CaptionText}" />
                                 </VerticalStackLayout>
                                 <dx:DXButton Grid.Column="1"
                                              Content="Log"
                                              SemanticProperties.Description="{Binding Name, StringFormat='Log {0}'}"
                                              SemanticProperties.Hint="Adds this food to today's log"
                                              Style="{StaticResource TextButton}"
                                              Command="{Binding Source={x:Reference Page}, Path=BindingContext.LogFoodCommand}"
                                              CommandParameter="{Binding .}" />
                             </Grid>
                         </dx:DXBorder>
                    </DataTemplate>
                </dx:DXCollectionView.ItemTemplate>
            </dx:DXCollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceS}"
                                 IsVisible="{Binding SearchResults, Converter={StaticResource HasItems}}">
            <Label Text="Search results" Style="{StaticResource SectionHeaderText}" SemanticProperties.HeadingLevel="Level2" />
            <dx:DXCollectionView ItemsSource="{Binding SearchResults}" HeightRequest="360">
                <dx:DXCollectionView.ItemTemplate>
                    <DataTemplate>
                         <dx:DXBorder Style="{StaticResource ListRow}">
                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                 <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                     <Label Text="{Binding Name}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                     <Label Text="{Binding Brand}" Style="{StaticResource SecondaryText}" />
                                     <Label Text="{Binding Nutrition}" Style="{StaticResource CaptionText}" />
                                 </VerticalStackLayout>
                                 <dx:DXButton Grid.Column="1"
                                              Content="Log"
                                              SemanticProperties.Description="{Binding Name, StringFormat='Log {0}'}"
                                              SemanticProperties.Hint="Adds this food to today's log"
                                              Style="{StaticResource TextButton}"
                                              Command="{Binding Source={x:Reference Page}, Path=BindingContext.LogFoodCommand}"
                                              CommandParameter="{Binding .}" />
                             </Grid>
                         </dx:DXBorder>
                    </DataTemplate>
                </dx:DXCollectionView.ItemTemplate>
            </dx:DXCollectionView>
            </VerticalStackLayout>

            <VerticalStackLayout Spacing="{StaticResource SpaceS}"
                                 IsVisible="{Binding FrequentFoods, Converter={StaticResource HasItems}}">
            <Label Text="Frequent shortcuts" Style="{StaticResource SectionHeaderText}" SemanticProperties.HeadingLevel="Level2" />
            <dx:DXCollectionView ItemsSource="{Binding FrequentFoods}"
                                 HeightRequest="160"
                                 ItemSpanCount="{Binding Source={x:Reference Adaptive}, Path=CardColumns}">
                <dx:DXCollectionView.ItemTemplate>
                    <DataTemplate>
                         <dx:DXBorder Style="{StaticResource ListRow}">
                             <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                 <Label Text="{Binding Name}" Style="{StaticResource BodyText}" VerticalTextAlignment="Center" />
                                 <dx:DXButton Grid.Column="1"
                                              Content="Log"
                                              SemanticProperties.Description="{Binding Name, StringFormat='Log {0}'}"
                                              SemanticProperties.Hint="Adds this food to today's log"
                                              Style="{StaticResource TextButton}"
                                              Command="{Binding Source={x:Reference Page}, Path=BindingContext.LogFoodCommand}"
                                              CommandParameter="{Binding .}" />
                             </Grid>
                         </dx:DXBorder>
                    </DataTemplate>
                </dx:DXCollectionView.ItemTemplate>
            </dx:DXCollectionView>
            </VerticalStackLayout>

            <Label Text="Logged today" Style="{StaticResource SectionHeaderText}" SemanticProperties.HeadingLevel="Level2" />
            <dx:DXButton Content="Copy yesterday"
                         SemanticProperties.Description="Copy yesterday"
                         SemanticProperties.Hint="Logs everything recorded yesterday against today"
                         Style="{StaticResource SecondaryButton}"
                         Command="{Binding CopyPreviousDayCommand}" />
            <dx:DXCollectionView ItemsSource="{Binding LoggedFoods}"
                                 HeightRequest="160"
                                 IsVisible="{Binding LoggedFoods, Converter={StaticResource HasItems}}">
                <dx:DXCollectionView.ItemTemplate>
                    <DataTemplate>
                        <dx:DXBorder Style="{StaticResource ListRow}">
                            <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                <Label Text="{Binding Meal}" Style="{StaticResource CaptionText}" />
                                <Label Text="{Binding Food}" Style="{StaticResource BodyText}" FontAttributes="Bold" />
                                <Label Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                            </VerticalStackLayout>
                        </dx:DXBorder>
                    </DataTemplate>
                </dx:DXCollectionView.ItemTemplate>
            </dx:DXCollectionView>
        </VerticalStackLayout>
    </ScrollView>
    </adaptive:AdaptiveHost>
</ContentPage>
