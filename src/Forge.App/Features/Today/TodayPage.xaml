<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             xmlns:motion="clr-namespace:Forge.App.Motion"
             x:Class="Forge.App.Features.Today.TodayPage"
             x:Name="Page"
             Title="Today"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        The Shell navigation bar is hidden on tab roots.

        The tab bar already names the destination, so a navigation bar titled "Today" above an
        in-page heading reading "Today" was pure duplication - it cost a fixed band of vertical
        space on every launch and said nothing. The in-page header replaces it, and unlike a Shell
        title it can carry the date, scroll away, and grow with the OS font scale.
    -->
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">
            <controls:PageHeader Eyebrow="{Binding DateLine}"
                                 Title="{Binding Greeting}"
                                 Subtitle="Everything here is read from what you have actually logged on this device."
                                 ActionText="Refresh"
                                 ActionCommand="{Binding RefreshCommand}" />

            <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="160" />

            <!-- The hero: one action, chosen from real state. -->
            <controls:ForgeCard Title="{Binding FocusHeadline}">
                <!--
                    A short staggered entrance on the cards that carry real content. The behaviour
                    reads Forge's shared motion preference and simply does not run when Reduce
                    Motion is on, so the screen appears instantly rather than degraded.
                -->
                <controls:ForgeCard.Behaviors>
                    <motion:StaggeredAppearBehavior Index="0" />
                </controls:ForgeCard.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="{Binding FocusMessage}" Style="{StaticResource BodyText}" />
                    <dx:DXButton Content="{Binding FocusActionText}"
                                 SemanticProperties.Description="{Binding FocusActionText}"
                                 SemanticProperties.Hint="Starts the session Forge has planned for today"
                                 Command="{Binding PrimaryActionCommand}"
                                 IsVisible="{Binding HasFocusAction}"
                                 Style="{StaticResource WorkoutActionButton}" />
                    <Label Text="{Binding SetupNudge}"
                           Style="{StaticResource CaptionText}"
                           IsVisible="{Binding HasSetupNudge}" />
                    <dx:DXButton Content="Finish setup"
                                 SemanticProperties.Description="Finish setup"
                                 Command="{Binding FinishSetupCommand}"
                                 IsVisible="{Binding HasSetupNudge}"
                                 Style="{StaticResource TextButton}"
                                 HorizontalOptions="Start" />
                </VerticalStackLayout>
            </controls:ForgeCard>

            <!-- Today's plan, only when there is a real plan to describe. -->
            <controls:ForgeCard Title="{Binding SessionTitle}"
                                Subtitle="{Binding SessionSubtitle}"
                                IsVisible="{Binding HasScheduledSession}">
                <controls:ForgeCard.Behaviors>
                    <motion:StaggeredAppearBehavior Index="1" />
                </controls:ForgeCard.Behaviors>
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="{Binding PlanDetail}" Style="{StaticResource SecondaryText}" />
                    <dx:DXButton Content="Open training"
                                 SemanticProperties.Description="Open training"
                                 Command="{Binding StartWorkoutCommand}"
                                 Style="{StaticResource PrimaryButton}" />
                </VerticalStackLayout>
            </controls:ForgeCard>

            <controls:EmptyState IsVisible="{Binding ShowsPlanPrompt}"
                                 Glyph="＋"
                                 Headline="No plan scheduled today"
                                 Message="Pick a plan and Forge will schedule sessions for you, fill the training ring as you log sets, and stop asking you what to do next."
                                 ActionText="Find training options"
                                 ActionCommand="{Binding CreatePlanCommand}" />

            <!--
                Rings.

                A wrapping FlexLayout with a percentage basis instead of a horizontal scroller: the
                scroller sized each card to a fixed width, which cut the third ring in half and
                truncated "Hydration" to "Hyd..." with no visible affordance that anything had been
                cut off. Percentage basis means the set always fits the viewport, and a fourth ring
                would wrap onto a second row rather than hide off-screen.
            -->
            <controls:SectionHeader Title="Activity rings" />
            <Label Text="{Binding RingSummary}" Style="{StaticResource SecondaryText}" />
            <FlexLayout BindableLayout.ItemsSource="{Binding Rings}"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Stretch">
                <FlexLayout.Behaviors>
                    <motion:StaggeredAppearBehavior Index="2" />
                </FlexLayout.Behaviors>
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <controls:ActivityRing Progress="{Binding Progress}"
                                               Label="{Binding Label}"
                                               Detail="{Binding Detail}"
                                               FlexLayout.Basis="31%" />
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </FlexLayout>
            <dx:DXButton Content="Log hydration"
                         SemanticProperties.Description="Log hydration"
                         SemanticProperties.Hint="Opens hydration logging, the quickest ring to move"
                         Command="{Binding LogHydrationCommand}"
                         Style="{StaticResource TextButton}"
                         HorizontalOptions="Start"
                         IsVisible="{Binding HasNoRingData}" />

            <controls:SectionHeader Title="Recent activity" />
            <controls:EmptyState IsVisible="{Binding HasNoRecentActivity}"
                                 Glyph="•"
                                 Headline="Nothing logged yet"
                                 Message="After your first workout or weight entry a short recap appears here. Forge leaves this empty rather than filling it with sample data you did not do."
                                 ActionText="Start logging"
                                 ActionCommand="{Binding StartWorkoutCommand}" />
            <VerticalStackLayout Spacing="{StaticResource SpaceXs}"
                                 IsVisible="{Binding HasRecentActivity}"
                                 BindableLayout.ItemsSource="{Binding RecentActivity}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate>
                        <dx:DXBorder Style="{StaticResource ListRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceXxs}">
                                    <Label Text="{Binding Title}" Style="{StaticResource TitleText}" />
                                    <Label Text="{Binding Detail}" Style="{StaticResource SecondaryText}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Text="{Binding When}"
                                       Style="{StaticResource CaptionText}"
                                       VerticalTextAlignment="Center" />
                            </Grid>
                        </dx:DXBorder>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
