<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:exercises="clr-namespace:Forge.App.Features.Exercises"
             x:Class="Forge.App.Features.Exercises.ExerciseLibraryPage"
             x:Name="Page"
             Title="Exercise library"
             BackgroundColor="{dx:ThemeColor Surface}">
    <ContentPage.Resources>
        <!--
            MultilineEdit is a sibling of TextEdit rather than a subclass, so the shared
            ForgeTextEdit style cannot target it. This mirrors that style until an equivalent
            can be added to ForgeStyles.xaml, which is a shared file.
        -->
        <Style x:Key="ForgeMultilineEdit" TargetType="dx:MultilineEdit">
            <Setter Property="BoxMode" Value="Outlined" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusM}" />
            <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetPrimary}" />
        </Style>

        <Style x:Key="FilterChipButton" TargetType="dx:DXButton">
            <Setter Property="ButtonType" Value="Outlined" />
            <Setter Property="MinimumHeightRequest" Value="{StaticResource TouchTargetMin}" />
            <Setter Property="CornerRadius" Value="{StaticResource RadiusPill}" />
        </Style>
    </ContentPage.Resources>

    <!--
        The library is the clearest case in Forge for a list-and-detail split: choosing between two
        movements is a comparison, and a comparison that needs a push and a back gesture between
        each look is one nobody actually performs. On a phone this collapses to exactly the layout
        it had before, and View pushes the detail page as it always did.
    -->
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <Grid ColumnDefinitions="{Binding Source={x:Reference Adaptive}, Path=SplitColumns}"
          ColumnSpacing="{Binding Source={x:Reference Adaptive}, Path=PaneSpacing}"
          Padding="{StaticResource PagePadding}">

    <Grid Grid.Column="0"
          Grid.ColumnSpan="{Binding ListPaneColumnSpan}"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="{StaticResource SpaceM}">

        <VerticalStackLayout Spacing="{StaticResource SpaceS}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                <Label Text="Exercise library"
                       Style="{StaticResource HeadlineText}"
                       SemanticProperties.HeadingLevel="Level1" />
                <dx:DXButton Grid.Column="1"
                             Content="New"
                             SemanticProperties.Description="Create a custom exercise"
                             Style="{StaticResource PrimaryButton}"
                             Command="{Binding NewExerciseCommand}" />
            </Grid>

            <dx:TextEdit Text="{Binding SearchText}"
                         PlaceholderText="Search name, muscle, equipment or pattern"
                         SemanticProperties.Description="Search the exercise library"
                         Style="{StaticResource ForgeTextEdit}" />

            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="{StaticResource SpaceS}">
                <dx:DXButton Content="{Binding FiltersButtonText}"
                             SemanticProperties.Description="Show or hide the filters"
                             Style="{StaticResource TextButton}"
                             Command="{Binding ToggleFiltersCommand}" />
                <dx:DXButton Grid.Column="1"
                             Content="Clear"
                             SemanticProperties.Description="Clear search and filters"
                             Style="{StaticResource TextButton}"
                             IsVisible="{Binding HasActiveFilters}"
                             Command="{Binding ClearFiltersCommand}" />
                <Label Grid.Column="2"
                       Text="{Binding CountSummary}"
                       Style="{StaticResource SecondaryText}"
                       HorizontalTextAlignment="End"
                       VerticalTextAlignment="Center" />
            </Grid>

            <dx:DXBorder Style="{StaticResource AdvisoryCard}" IsVisible="{Binding HasDeclaredLimitations}">
                <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                    <Label Text="Your movement limitations"
                           Style="{StaticResource TitleText}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding LimitationSummary}" Style="{StaticResource BodyText}" />
                    <Label Text="{Binding LimitationUnreadNotice}"
                           Style="{StaticResource BodyText}"
                           IsVisible="{Binding HasUnreadLimitations}" />
                    <dx:DXButton Content="{Binding LimitationFilterButtonText}"
                                 SemanticProperties.Description="Turn filtering by your declared movement limitations on or off"
                                 Style="{StaticResource SecondaryButton}"
                                 IsVisible="{Binding CanToggleLimitationFilter}"
                                 Command="{Binding ToggleLimitationFilterCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource AdvisoryCard}" IsVisible="{Binding HasActionMessage}">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                    <Label Text="{Binding ActionMessage}"
                           Style="{StaticResource BodyText}"
                           TextColor="{dx:ThemeColor OnErrorContainer}"
                           VerticalTextAlignment="Center" />
                    <dx:DXButton Grid.Column="1"
                                 Content="Dismiss"
                                 SemanticProperties.Description="Dismiss this message"
                                 Style="{StaticResource TextButton}"
                                 Command="{Binding DismissActionMessageCommand}" />
                </Grid>
            </dx:DXBorder>
        </VerticalStackLayout>

        <VerticalStackLayout Grid.Row="1"
                             Spacing="{StaticResource SpaceXs}"
                             IsVisible="{Binding AreFiltersVisible}">
            <Label Text="Show" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding ScopeChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource FilterChipButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.SelectScopeCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="Movement pattern" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding PatternChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource FilterChipButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.TogglePatternCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="Muscle" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding MuscleChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource FilterChipButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleMuscleCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="Equipment" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding EquipmentChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource FilterChipButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleEquipmentCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="Difficulty" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding DifficultyChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource FilterChipButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleDifficultyCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
        </VerticalStackLayout>

        <Grid Grid.Row="2">

            <ScrollView IsVisible="{Binding IsEditorVisible}">
                <dx:DXBorder Style="{StaticResource Card}"
                             HorizontalOptions="Center"
                             WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ReadingWidth}">
                    <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                        <Label Text="{Binding EditorTitle}"
                               Style="{StaticResource TitleText}"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="Everything except the name is optional. Anything you fill in shows on the exercise page exactly as the shipped movements do."
                               Style="{StaticResource CaptionText}" />

                        <dx:TextEdit Text="{Binding EditName}"
                                     PlaceholderText="Exercise name"
                                     SemanticProperties.Description="Exercise name"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <dx:TextEdit Text="{Binding EditPrimaryMuscle}"
                                     PlaceholderText="Primary muscle"
                                     SemanticProperties.Description="Primary muscle"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <dx:TextEdit Text="{Binding EditSecondaryMuscles}"
                                     PlaceholderText="Secondary muscles, separated by commas"
                                     SemanticProperties.Description="Secondary muscles, separated by commas"
                                     Style="{StaticResource ForgeTextEdit}" />
                        <dx:TextEdit Text="{Binding EditEquipment}"
                                     PlaceholderText="Equipment (leave blank for bodyweight)"
                                     SemanticProperties.Description="Equipment, left blank for bodyweight"
                                     Style="{StaticResource ForgeTextEdit}" />

                        <Label Text="Movement pattern" Style="{StaticResource CaptionText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding PatternOptions}"
                                         SelectedItem="{Binding SelectedPattern}"
                                         SemanticProperties.Description="Movement pattern"
                                         Style="{StaticResource ForgeTextEdit}" />

                        <Label Text="Difficulty" Style="{StaticResource CaptionText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding DifficultyOptions}"
                                         SelectedItem="{Binding SelectedDifficulty}"
                                         SemanticProperties.Description="Difficulty"
                                         Style="{StaticResource ForgeTextEdit}" />

                        <Label Text="Force" Style="{StaticResource CaptionText}" />
                        <dx:ComboBoxEdit ItemsSource="{Binding ForceTypeOptions}"
                                         SelectedItem="{Binding SelectedForceType}"
                                         SemanticProperties.Description="Force type"
                                         Style="{StaticResource ForgeTextEdit}" />

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource SpaceM}">
                            <dx:CheckEdit IsChecked="{Binding EditIsUnilateral}"
                                          SemanticProperties.Description="Trained one side at a time" />
                            <Label Grid.Column="1"
                                   Text="Trained one side at a time"
                                   Style="{StaticResource BodyText}"
                                   VerticalTextAlignment="Center" />
                        </Grid>

                        <dx:MultilineEdit Text="{Binding EditExecutionSteps}"
                                          PlaceholderText="Execution steps, one per line"
                                          SemanticProperties.Description="Execution steps, one per line"
                                          Style="{StaticResource ForgeMultilineEdit}" />
                        <dx:MultilineEdit Text="{Binding EditCoachingCues}"
                                          PlaceholderText="Coaching cues, one per line"
                                          SemanticProperties.Description="Coaching cues, one per line"
                                          Style="{StaticResource ForgeMultilineEdit}" />
                        <dx:MultilineEdit Text="{Binding EditCommonMistakes}"
                                          PlaceholderText="Common mistakes, one per line"
                                          SemanticProperties.Description="Common mistakes, one per line"
                                          Style="{StaticResource ForgeMultilineEdit}" />
                        <dx:MultilineEdit Text="{Binding EditSafetyNotes}"
                                          PlaceholderText="Safety notes, one per line"
                                          SemanticProperties.Description="Safety notes, one per line"
                                          Style="{StaticResource ForgeMultilineEdit}" />

                        <HorizontalStackLayout Spacing="{StaticResource SpaceS}">
                            <dx:DXButton Content="Save"
                                         SemanticProperties.Description="Save this exercise"
                                         Style="{StaticResource PrimaryButton}"
                                         Command="{Binding SaveExerciseCommand}" />
                            <dx:DXButton Content="Cancel"
                                         SemanticProperties.Description="Cancel editing"
                                         Style="{StaticResource TextButton}"
                                         Command="{Binding CancelEditCommand}" />
                        </HorizontalStackLayout>
                    </VerticalStackLayout>
                </dx:DXBorder>
            </ScrollView>

            <Grid IsVisible="{Binding IsListVisible}">
                <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="{StaticResource SpaceM}">
                    <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="88" />
                    <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="88" />
                    <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="88" />
                </VerticalStackLayout>

                <controls:EmptyState IsVisible="{Binding HasError}"
                                     Glyph="!"
                                     Headline="Exercise library unavailable"
                                     Message="{Binding ErrorMessage}" />

                <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                     Headline="Nothing matches"
                                     Message="Try a different search, clear a filter, or create your own exercise." />

                <dx:DXCollectionView ItemsSource="{Binding Exercises}" IsVisible="{Binding HasExercises}">
                    <dx:DXCollectionView.ItemTemplate>
                        <DataTemplate>
                            <dx:DXBorder Style="{StaticResource ListRow}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                    <VerticalStackLayout Spacing="{StaticResource SpaceXxs}"
                                                         SemanticProperties.Description="{Binding AccessibilityDescription}">
                                        <Label Text="{Binding Name}" Style="{StaticResource TitleText}" />
                                        <Label Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                                        <Label Text="{Binding Pattern}" Style="{StaticResource CaptionText}" />
                                        <Label Text="{Binding MatchExplanation}"
                                               Style="{StaticResource CaptionText}"
                                               TextColor="{dx:ThemeColor Primary}"
                                               IsVisible="{Binding HasMatchExplanation}" />
                                        <Label Text="{Binding RecentSummary}" Style="{StaticResource CaptionText}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="{StaticResource SpaceXxs}">
                                        <dx:DXButton Content="{Binding FavouriteGlyph}"
                                                     SemanticProperties.Description="{Binding FavouriteDescription}"
                                                     Style="{StaticResource TextButton}"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleFavouriteCommand}"
                                                     CommandParameter="{Binding .}" />
                                        <dx:DXButton Content="View"
                                                     SemanticProperties.Description="View this exercise"
                                                     Style="{StaticResource TextButton}"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenExerciseCommand}"
                                                     CommandParameter="{Binding .}" />
                                        <dx:DXButton Content="Edit"
                                                     SemanticProperties.Description="Edit this custom exercise"
                                                     Style="{StaticResource TextButton}"
                                                     IsVisible="{Binding IsUserCreated}"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.EditExerciseCommand}"
                                                     CommandParameter="{Binding .}" />
                                        <dx:DXButton Content="Delete"
                                                     SemanticProperties.Description="Delete this custom exercise"
                                                     Style="{StaticResource TextButton}"
                                                     IsVisible="{Binding IsUserCreated}"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.DeleteExerciseCommand}"
                                                     CommandParameter="{Binding .}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </dx:DXBorder>
                        </DataTemplate>
                    </dx:DXCollectionView.ItemTemplate>
                </dx:DXCollectionView>
            </Grid>
        </Grid>
    </Grid>

    <!--
        The detail pane. Hidden while the editor is open, because the editor takes the width; and
        hidden entirely when the window is too narrow, at which point View pushes the detail page
        instead. The pane starts empty rather than pre-selecting the first exercise: opening one
        marks it as recently used, and inventing that history for a movement nobody looked at would
        quietly corrupt the Recently used filter.
    -->
    <dx:DXBorder Grid.Column="1"
                 Style="{StaticResource DetailPane}"
                 IsVisible="{Binding IsDetailPaneVisible}">
        <Grid>
            <controls:EmptyState IsVisible="{Binding HasNoDetailSelection}"
                                 Glyph="&#8592;"
                                 Headline="Pick a movement"
                                 Message="Choose an exercise on the left and its full technique guidance opens here, beside the list." />
            <!--
                A second host, measuring the pane rather than the page. The reading measure has to
                be taken from the width the prose actually gets: capping against the window would
                force a 680 point column into a 420 point pane on a small tablet.
            -->
            <adaptive:AdaptiveHost x:Name="DetailAdaptive" IsVisible="{Binding HasDetailSelection}">
                <exercises:ExerciseGuidanceView BindingContext="{Binding Detail}"
                                                HorizontalOptions="Center"
                                                WidthRequest="{Binding Source={x:Reference DetailAdaptive}, Path=ReadingWidth}" />
            </adaptive:AdaptiveHost>
        </Grid>
    </dx:DXBorder>

    </Grid>
    </adaptive:AdaptiveHost>
</ContentPage>
