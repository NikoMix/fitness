<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:exercises="clr-namespace:Forge.App.Features.Exercises"
             x:Class="Forge.App.Features.Exercises.ExerciseDetailPage"
             Title="Exercise"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        Long-form technique guidance, so this uses the tight reading measure rather than the looser
        content one. Left uncapped on a 13-inch iPad a coaching cue runs to roughly 180 characters
        a line, about twice the width at which the eye reliably finds the start of the next one.

        The body lives in ExerciseGuidanceView because the tablet library shows the same thing in
        its detail pane rather than pushing this page.
    -->
    <adaptive:AdaptiveHost x:Name="Adaptive">
        <exercises:ExerciseGuidanceView Padding="{StaticResource PagePadding}"
                                        Style="{StaticResource MeasuredColumn}"
                                        WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ReadingWidth}" />
    </adaptive:AdaptiveHost>
</ContentPage>
