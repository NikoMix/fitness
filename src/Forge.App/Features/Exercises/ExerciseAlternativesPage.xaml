<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Exercises.ExerciseAlternativesPage"
             x:Name="Page"
             Title="Alternatives"
             BackgroundColor="{dx:ThemeColor Surface}">
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <Grid RowDefinitions="Auto,*" Padding="{StaticResource PagePadding}"
                                  HorizontalOptions="Center"
                                  WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ContentWidth}" RowSpacing="{StaticResource SpaceL}">

        <VerticalStackLayout Spacing="{StaticResource SpaceS}">
            <Label Text="{Binding Title}"
                   Style="{StaticResource HeadlineText}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="What have you got right now?" Style="{StaticResource CaptionText}" />
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="{StaticResource SpaceS}"
                                       BindableLayout.ItemsSource="{Binding EquipmentChips}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <dx:DXButton Content="{Binding DisplayText}"
                                         SemanticProperties.Description="{Binding AccessibilityDescription}"
                                         Style="{StaticResource SecondaryButton}"
                                         Command="{Binding Source={x:Reference Page}, Path=BindingContext.ToggleEquipmentCommand}"
                                         CommandParameter="{Binding .}" />
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </HorizontalStackLayout>
            </ScrollView>
            <Label Text="{Binding Explanation}" Style="{StaticResource SecondaryText}" />
            <Label Text="{Binding UnlockHint}"
                   Style="{StaticResource CaptionText}"
                   IsVisible="{Binding HasUnlockHint}" />
        </VerticalStackLayout>

        <Grid Grid.Row="1">
            <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="{StaticResource SpaceM}">
                <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="88" />
                <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="88" />
            </VerticalStackLayout>

            <controls:EmptyState IsVisible="{Binding HasError}"
                                 Glyph="!"
                                 Headline="Alternatives unavailable"
                                 Message="{Binding ErrorMessage}" />

            <!--
                An empty result is a real answer here, not a failure. The explanation says why
                nothing qualified, which is more useful than a list padded with movements that
                train something else.
            -->
            <controls:EmptyState IsVisible="{Binding IsEmpty}"
                                 Headline="No suitable alternative"
                                 Message="{Binding Explanation}" />

            <dx:DXCollectionView ItemsSource="{Binding Alternatives}" IsVisible="{Binding HasAlternatives}"
                                 ItemSpanCount="{Binding Source={x:Reference Adaptive}, Path=CardColumns}">
                <dx:DXCollectionView.ItemTemplate>
                    <DataTemplate>
                        <dx:DXBorder Style="{StaticResource ListRow}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                                <VerticalStackLayout Spacing="{StaticResource SpaceXs}"
                                                     SemanticProperties.Description="{Binding AccessibilityDescription}">
                                    <Label Text="{Binding Name}" Style="{StaticResource TitleText}" />
                                    <Label Text="{Binding QualityBadge}"
                                           Style="{StaticResource CaptionText}"
                                           TextColor="{dx:ThemeColor Primary}" />
                                    <Label Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                                    <Label Text="{Binding RankReason}" Style="{StaticResource CaptionText}" />
                                </VerticalStackLayout>
                                <dx:DXButton Grid.Column="1"
                                             Content="View"
                                             SemanticProperties.Description="View this alternative"
                                             Style="{StaticResource TextButton}"
                                             Command="{Binding Source={x:Reference Page}, Path=BindingContext.OpenAlternativeCommand}"
                                             CommandParameter="{Binding .}" />
                            </Grid>
                        </dx:DXBorder>
                    </DataTemplate>
                </dx:DXCollectionView.ItemTemplate>
            </dx:DXCollectionView>
        </Grid>
    </Grid>
    </adaptive:AdaptiveHost>
</ContentPage>