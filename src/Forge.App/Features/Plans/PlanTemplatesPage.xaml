<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.Features.Plans.PlanTemplatesPage"
             x:Name="Page"
             Title="Programme templates"
             BackgroundColor="{dx:ThemeColor Surface}">
    <!--
        Adopting a programme is a commitment to several weeks of training, and the only way to
        judge one is to read the week it produces. On a phone that means a summary bar under the
        list; once there is room it becomes a real preview pane, because the whole decision is a
        comparison between templates and a comparison needs both things visible at once.
    -->
    <adaptive:AdaptiveHost x:Name="Adaptive">
        <Grid ColumnDefinitions="{Binding Source={x:Reference Adaptive}, Path=SplitColumns}"
              ColumnSpacing="{Binding Source={x:Reference Adaptive}, Path=PaneSpacing}"
              Padding="{StaticResource PagePadding}">

            <Grid Grid.Column="0" RowDefinitions="Auto,*,Auto" RowSpacing="{StaticResource SpaceL}">
                <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                    <Label Text="Templates" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Choose a starting point, preview the week, then edit anything." Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>

                <Grid Grid.Row="1">
                    <controls:SkeletonPlaceholder IsBusy="{Binding IsLoading}" HeightRequest="112" />
                    <dx:DXCollectionView ItemsSource="{Binding Templates}">
                        <dx:DXCollectionView.ItemTemplate>
                            <DataTemplate>
                                <controls:ForgeCard Title="{Binding Name}" Subtitle="{Binding Summary}">
                                    <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                                        <Label Text="{Binding Description}" Style="{StaticResource BodyText}" />
                                        <dx:DXButton Content="Preview week"
                                                     SemanticProperties.Description="Preview week"
                                                     ButtonType="Text"
                                                     Command="{Binding Source={x:Reference Page}, Path=BindingContext.PreviewTemplateCommand}"
                                                     CommandParameter="{Binding .}" />
                                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Days}" Spacing="{StaticResource SpaceXs}">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate>
                                                    <Label Text="{Binding Summary, StringFormat='&#183; {0}'}" Style="{StaticResource CaptionText}" />
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </VerticalStackLayout>
                                    </VerticalStackLayout>
                                </controls:ForgeCard>
                            </DataTemplate>
                        </dx:DXCollectionView.ItemTemplate>
                    </dx:DXCollectionView>
                </Grid>

                <!--
                    The compact summary bar. Replaced by the pane on the right as soon as there is
                    room for one, rather than shown twice.
                -->
                <dx:DXBorder Grid.Row="2"
                             Style="{StaticResource ElevatedCard}"
                             IsVisible="{Binding Source={x:Reference Adaptive}, Path=IsStacked}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{StaticResource SpaceM}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <Label Text="{Binding SelectedTemplate.Name}" Style="{StaticResource TitleText}" />
                            <Label Text="{Binding SelectedTemplate.Summary}" Style="{StaticResource SecondaryText}" />
                        </VerticalStackLayout>
                        <dx:DXButton Grid.Column="1"
                                     Content="Adopt"
                                     SemanticProperties.Description="Adopt this template"
                                     Style="{StaticResource PrimaryButton}"
                                     Command="{Binding AdoptTemplateCommand}"
                                     CommandParameter="{Binding SelectedTemplate}" />
                    </Grid>
                </dx:DXBorder>
            </Grid>

            <dx:DXBorder Grid.Column="1"
                         Style="{StaticResource DetailPane}"
                         IsVisible="{Binding Source={x:Reference Adaptive}, Path=IsSplit}">
                <!--
                    A second host, measuring the pane rather than the page. A template description
                    is prose, and the pane is nearly a thousand points wide on a 13-inch display.
                -->
                <adaptive:AdaptiveHost x:Name="PreviewAdaptive">
                <ScrollView>
                    <VerticalStackLayout Spacing="{StaticResource SpaceL}"
                                         HorizontalOptions="Center"
                                         WidthRequest="{Binding Source={x:Reference PreviewAdaptive}, Path=ReadingWidth}">
                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                            <Label Text="{Binding SelectedTemplate.Name}"
                                   Style="{StaticResource HeadlineText}"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding SelectedTemplate.Summary}" Style="{StaticResource SecondaryText}" />
                            <Label Text="{Binding SelectedTemplate.Description}" Style="{StaticResource BodyText}" />
                        </VerticalStackLayout>

                        <dx:DXButton Content="Adopt this programme"
                                     SemanticProperties.Description="Adopt this template"
                                     Style="{StaticResource PrimaryButton}"
                                     Command="{Binding AdoptTemplateCommand}"
                                     CommandParameter="{Binding SelectedTemplate}" />

                        <Label Text="The week it produces" Style="{StaticResource SectionHeaderText}" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SelectedTemplate.Days}"
                                             Spacing="{StaticResource SpaceS}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <dx:DXBorder Style="{StaticResource Card}">
                                        <VerticalStackLayout Spacing="{StaticResource SpaceXs}">
                                            <Label Text="{Binding Name}" Style="{StaticResource TitleText}" />
                                            <Label Text="{Binding Summary}" Style="{StaticResource SecondaryText}" />
                                        </VerticalStackLayout>
                                    </dx:DXBorder>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
                </adaptive:AdaptiveHost>
            </dx:DXBorder>
        </Grid>
    </adaptive:AdaptiveHost>
</ContentPage>