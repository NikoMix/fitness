<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             xmlns:adaptive="clr-namespace:Forge.App.Adaptive"
             x:Class="Forge.App.Features.Train.TrainPage"
             Title="Train"
             BackgroundColor="{dx:ThemeColor Surface}">
    <adaptive:AdaptiveHost x:Name="Adaptive">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}"
                             HorizontalOptions="Center"
                             WidthRequest="{Binding Source={x:Reference Adaptive}, Path=ContentWidth}" Spacing="{StaticResource SpaceL}">
            <Label Text="Train" Style="{StaticResource HeadlineText}" SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Plan sessions, review movement options, and start from the exercise library when equipment changes." Style="{StaticResource SecondaryText}" />
            <dx:DXBorder Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Exercise library" Style="{StaticResource TitleText}" />
                    <Label Text="Browse the offline catalogue, review form notes, and find substitutions for the equipment you have today." Style="{StaticResource BodyText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceS}">
                        <dx:DXButton Content="Browse exercises"
                                     Style="{StaticResource PrimaryButton}"
                                     SemanticProperties.Description="Browse exercises"
                                     SemanticProperties.Hint="Opens the offline exercise library"
                                     Command="{Binding OpenExerciseLibraryCommand}" />
                        <dx:DXButton Grid.Column="1"
                                     Content="Video library"
                                     Style="{StaticResource SecondaryButton}"
                                     SemanticProperties.Description="Open the video library"
                                     SemanticProperties.Hint="Manage downloaded technique videos and their quality"
                                     Command="{Binding OpenVideoLibraryCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Train now" Style="{StaticResource TitleText}" />
                    <Label Text="Start logging straight away. Forge keeps the session recoverable, so an interrupted workout is never lost." Style="{StaticResource BodyText}" />
                    <dx:DXButton Content="Start workout"
                                 Style="{StaticResource WorkoutActionButton}"
                                 SemanticProperties.Description="Start a workout"
                                 SemanticProperties.Hint="Opens the active workout screen"
                                 Command="{Binding StartWorkoutCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Readiness and coaching" Style="{StaticResource TitleText}" />
                    <Label Text="Log how you slept and how sore you are, and Forge will say whether today looks like a day to push or a day to hold back. It is guidance from your own logs, not a diagnosis." Style="{StaticResource BodyText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceS}">
                        <dx:DXButton Content="Morning check-in"
                                     Style="{StaticResource PrimaryButton}"
                                     SemanticProperties.Description="Open the morning check-in"
                                     SemanticProperties.Hint="Record sleep, soreness and energy for today"
                                     Command="{Binding OpenMorningCheckInCommand}" />
                        <dx:DXButton Grid.Column="1"
                                     Content="Today's readiness"
                                     Style="{StaticResource SecondaryButton}"
                                     SemanticProperties.Description="View today's readiness"
                                     SemanticProperties.Hint="Shows how ready you are to train, based on your own check-ins"
                                     Command="{Binding OpenReadinessCommand}" />
                    </Grid>
                    <dx:DXButton Content="Coaching guidance"
                                 Style="{StaticResource SecondaryButton}"
                                 SemanticProperties.Description="Open coaching guidance"
                                 SemanticProperties.Hint="Suggestions drawn from your recent training and recovery"
                                 Command="{Binding OpenCoachingCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource ElevatedCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Workout history" Style="{StaticResource TitleText}" />
                    <Label Text="Every past session, newest first, with volume, working sets and how long it took." Style="{StaticResource BodyText}" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="{StaticResource SpaceS}">
                        <dx:DXButton Content="View history"
                                     Style="{StaticResource SecondaryButton}"
                                     SemanticProperties.Description="View workout history"
                                     SemanticProperties.Hint="Opens past sessions, newest first"
                                     Command="{Binding OpenWorkoutHistoryCommand}" />
                        <dx:DXButton Grid.Column="1"
                                     Content="Plate calculator"
                                     Style="{StaticResource SecondaryButton}"
                                     SemanticProperties.Description="Open the plate calculator"
                                     SemanticProperties.Hint="Works out which plates to load for a target weight"
                                     Command="{Binding OpenPlateCalculatorCommand}" />
                    </Grid>
                </VerticalStackLayout>
            </dx:DXBorder>
        </VerticalStackLayout>
    </ScrollView>
    </adaptive:AdaptiveHost>
</ContentPage>
