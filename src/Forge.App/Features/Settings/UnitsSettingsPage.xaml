<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Features.Settings.UnitsSettingsPage"
             Title="Units"
             BackgroundColor="{dx:ThemeColor Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">
            <Label Text="Units and formats"
                   Style="{StaticResource HeadlineText}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Forge stores canonical metric values locally and formats every display through this preference layer."
                   Style="{StaticResource SecondaryText}" />

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Mass" Style="{StaticResource TitleText}" />
                    <dx:ComboBoxEdit ItemsSource="{Binding MassUnitOptions}"
                                     SelectedItem="{Binding SelectedMassUnit, Mode=TwoWay}" />
                    <Label Text="{Binding PreviewMass}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Length" Style="{StaticResource TitleText}" />
                    <dx:ComboBoxEdit ItemsSource="{Binding LengthUnitOptions}"
                                     SelectedItem="{Binding SelectedLengthUnit, Mode=TwoWay}" />
                    <Label Text="{Binding PreviewLength}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Volume" Style="{StaticResource TitleText}" />
                    <dx:ComboBoxEdit ItemsSource="{Binding VolumeUnitOptions}"
                                     SelectedItem="{Binding SelectedVolumeUnit, Mode=TwoWay}" />
                    <Label Text="{Binding PreviewVolume}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Energy" Style="{StaticResource TitleText}" />
                    <dx:ComboBoxEdit ItemsSource="{Binding EnergyUnitOptions}"
                                     SelectedItem="{Binding SelectedEnergyUnit, Mode=TwoWay}" />
                    <Label Text="{Binding PreviewEnergy}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="First day of week" Style="{StaticResource TitleText}" />
                    <dx:ComboBoxEdit ItemsSource="{Binding FirstDayOptions}"
                                     SelectedItem="{Binding SelectedFirstDay, Mode=TwoWay}" />
                    <Label Text="{Binding PreviewWeek}" Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
