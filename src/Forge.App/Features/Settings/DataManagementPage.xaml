<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Features.Settings.DataManagementPage"
             Title="Data management"
             BackgroundColor="{dx:ThemeColor Surface}">
    <ScrollView>
        <VerticalStackLayout Padding="{StaticResource PagePadding}" Spacing="{StaticResource SpaceL}">
            <Label Text="Data management"
                   Style="{StaticResource HeadlineText}"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Forge is local-first. There is no server copy of your workouts, nutrition, body metrics or settings."
                   Style="{StaticResource SecondaryText}" />

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Storage usage" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding StorageUsage}" Style="{StaticResource BodyText}" />
                    <dx:DXButton Content="Refresh storage usage"
                                 SemanticProperties.Description="Refresh storage usage"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding RefreshStorageCommand}" />
                    <dx:DXButton Content="Reclaim downloaded media"
                                 SemanticProperties.Description="Reclaim downloaded media"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding ReclaimMediaCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>
 
            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Backup and export" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding BackupStatus}" Style="{StaticResource SecondaryText}" />
                    <dx:DXButton Content="Backup and restore"
                                 SemanticProperties.Description="Backup and restore"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding OpenBackupRestoreCommand}" />
                    <dx:DXButton Content="Export data"
                                 SemanticProperties.Description="Export data"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding OpenExportDataCommand}" />
                    <dx:DXButton Content="Import data"
                                 SemanticProperties.Description="Import data"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding OpenImportDataCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource AdvisoryCard}"
                         IsVisible="{Binding HasRecentCrash}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Forge closed unexpectedly" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding RecentCrashSummary}" Style="{StaticResource BodyText}" />
                    <Label Text="A diagnostic log was saved on this device. You can read it and send it below, or leave it where it is."
                           Style="{StaticResource SecondaryText}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Diagnostic log" Style="{StaticResource TitleText}" />
                    <Label Text="{Binding DiagnosticStatus}" Style="{StaticResource BodyText}" />
                    <!--
                        Written to be read, not to be agreed to.

                        Forge has no crash reporter and no analytics, so this file is the only
                        evidence that will ever exist when something goes wrong. That makes it
                        worth offering - and it makes it worth being exact about, because the
                        person deciding is deciding about a file next to a database Forge went to
                        considerable trouble to encrypt. Saying "no personal data" would be a
                        claim; saying what was removed and what was kept is a description.
                    -->
                    <Label Text="Forge records what it was doing when something goes wrong. Body measurements, food and drink, injuries, notes, names, dates and file paths are removed before anything is written. What stays is the times Forge was running, error type names and internal code locations."
                           Style="{StaticResource SecondaryText}" />
                    <Label Text="Nothing is ever sent anywhere unless you send it."
                           Style="{StaticResource SecondaryText}" />
                    <dx:DXButton Content="Send the diagnostic log"
                                 SemanticProperties.Description="Send the diagnostic log"
                                 SemanticProperties.Hint="Opens the share sheet so you can attach the log to a message. Nothing is sent until you choose where."
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding ShareDiagnosticsCommand}" />
                    <dx:DXButton Content="Delete the diagnostic log"
                                 SemanticProperties.Description="Delete the diagnostic log"
                                 SemanticProperties.Hint="Removes every saved log file from this device"
                                 Style="{StaticResource SecondaryButton}"
                                 Command="{Binding DeleteDiagnosticsCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>

            <dx:DXBorder Style="{StaticResource AdvisoryCard}">
                <VerticalStackLayout Spacing="{StaticResource SpaceM}">
                    <Label Text="Delete my data" Style="{StaticResource TitleText}" />
                    <Label Text="This opens the required irreversible deletion flow. It is never a single tap."
                           Style="{StaticResource BodyText}" />
                    <dx:DXButton Content="Open delete-my-data"
                                 SemanticProperties.Description="Open delete-my-data"
                                 Style="{StaticResource PrimaryButton}"
                                 Command="{Binding OpenDeleteMyDataCommand}" />
                </VerticalStackLayout>
            </dx:DXBorder>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
