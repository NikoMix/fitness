<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Controls.EmptyState"
             x:Name="Root">
    <dx:DXBorder x:Name="StateChrome"
                 Style="{StaticResource EmptyStateCard}">
        <VerticalStackLayout Spacing="{StaticResource SpaceL}"
                             HorizontalOptions="Center">
            <Label x:Name="GlyphLabel"
                   Text="{Binding Glyph, Source={x:Reference Root}}"
                   FontSize="{StaticResource FontHeadlineL}"
                   TextColor="{dx:ThemeColor Primary}"
                   HorizontalTextAlignment="Center"
                   AutomationProperties.IsInAccessibleTree="False" />
            <VerticalStackLayout Spacing="{StaticResource SpaceS}">
                <Label x:Name="HeadlineLabel"
                       Text="{Binding Headline, Source={x:Reference Root}}"
                       Style="{StaticResource HeadlineText}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap"
                       SemanticProperties.HeadingLevel="Level2" />
                <Label x:Name="MessageLabel"
                       Text="{Binding Message, Source={x:Reference Root}}"
                       Style="{StaticResource SecondaryText}"
                       HorizontalTextAlignment="Center"
                       LineBreakMode="WordWrap" />
            </VerticalStackLayout>
            <dx:DXButton x:Name="ActionButton"
                         Content="{Binding ActionText, Source={x:Reference Root}}"
                         Command="{Binding ActionCommand, Source={x:Reference Root}}"
                         Style="{StaticResource PrimaryButton}"
                         HorizontalOptions="Center"
                         MinimumWidthRequest="160" />
        </VerticalStackLayout>
    </dx:DXBorder>
</ContentView>
