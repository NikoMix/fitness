<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Controls.SectionHeader"
             x:Name="Root"
             MinimumHeightRequest="{StaticResource TouchTargetMin}">
    <Grid ColumnDefinitions="*,Auto"
          ColumnSpacing="{StaticResource SpaceM}"
          VerticalOptions="Center">
        <Label x:Name="TitleLabel"
               Grid.Column="0"
               Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource SectionHeaderText}"
               LineBreakMode="WordWrap"
               VerticalTextAlignment="Center"
               SemanticProperties.HeadingLevel="Level2" />
        <dx:DXButton x:Name="ActionButton"
                     Grid.Column="1"
                     Content="{Binding ActionText, Source={x:Reference Root}}"
                     Command="{Binding ActionCommand, Source={x:Reference Root}}"
                     Style="{StaticResource TextButton}"
                     MinimumWidthRequest="{StaticResource TouchTargetMin}" />
    </Grid>
</ContentView>
