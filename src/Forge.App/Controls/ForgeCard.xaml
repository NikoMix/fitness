<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Controls.ForgeCard"
             x:Name="Root">
    <dx:DXBorder x:Name="CardChrome"
                 Style="{StaticResource Card}">
        <VerticalStackLayout Spacing="{StaticResource SpaceM}">
            <VerticalStackLayout x:Name="HeaderLayout"
                                 Spacing="{StaticResource SpaceXxs}">
                <Label x:Name="TitleLabel"
                       Text="{Binding Title, Source={x:Reference Root}}"
                       Style="{StaticResource TitleText}"
                       SemanticProperties.HeadingLevel="Level2" />
                <Label x:Name="SubtitleLabel"
                       Text="{Binding Subtitle, Source={x:Reference Root}}"
                       Style="{StaticResource SecondaryText}" />
            </VerticalStackLayout>
            <ContentPresenter x:Name="BodyPresenter" />
        </VerticalStackLayout>
    </dx:DXBorder>
</ContentView>
