<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Controls.MetricTile"
             x:Name="Root">
    <dx:DXBorder x:Name="TileChrome"
                 Style="{StaticResource MetricTileCard}">
        <VerticalStackLayout Spacing="{StaticResource SpaceXs}"
                             HorizontalOptions="Center">
            <Grid ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="{StaticResource SpaceXs}"
                  HorizontalOptions="Center">
                <Label x:Name="ValueLabel"
                       Grid.Column="0"
                       Text="{Binding Value, Source={x:Reference Root}}"
                       Style="{StaticResource MetricText}"
                       LineBreakMode="NoWrap"
                       AutomationProperties.IsInAccessibleTree="False" />
                <Label x:Name="UnitLabel"
                       Grid.Column="1"
                       Text="{Binding Unit, Source={x:Reference Root}}"
                       Style="{StaticResource MetricUnitText}"
                       LineBreakMode="WordWrap"
                       HorizontalOptions="Start"
                       VerticalOptions="End"
                       AutomationProperties.IsInAccessibleTree="False" />
            </Grid>
            <Label x:Name="CaptionLabel"
                   Text="{Binding Caption, Source={x:Reference Root}}"
                   Style="{StaticResource CaptionText}"
                   HorizontalTextAlignment="Center"
                   LineBreakMode="WordWrap"
                   AutomationProperties.IsInAccessibleTree="False" />
        </VerticalStackLayout>
    </dx:DXBorder>
</ContentView>
