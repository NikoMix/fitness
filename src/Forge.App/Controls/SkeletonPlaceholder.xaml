<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:dx="http://schemas.devexpress.com/maui"
             x:Class="Forge.App.Controls.SkeletonPlaceholder"
             x:Name="Root"
             IsVisible="{Binding IsBusy, Source={x:Reference Root}}">
    <dx:DXBorder x:Name="SkeletonBlock"
                 Style="{StaticResource SkeletonBlock}"
                 SemanticProperties.Description="Loading content" />
</ContentView>
