<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:Forge.App.Controls"
             x:Class="Forge.App.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    Order matters. ForgeStyles resolves StaticResource references into
                    ForgeTokens, and StaticResource is resolved at parse time, so the tokens
                    must already be merged when the styles are read.

                    Colors.xaml and Styles.xaml are the MAUI template defaults. They are kept
                    because the stock MAUI controls used alongside DevExpress still rely on
                    them, but Forge screens should prefer ForgeStyles and DevExpress theme
                    roles over anything defined there.
                -->
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ForgeTokens.xaml" />
                <ResourceDictionary Source="Resources/Styles/ForgeStyles.xaml" />
                <ResourceDictionary Source="Resources/Styles/ForgeAdaptive.xaml" />
                <ResourceDictionary Source="Resources/Styles/ForgeMotion.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                A list that is given a height keeps that height when it empties, leaving a
                container with nothing to draw and nothing for a screen reader to announce.
                Sections bind their visibility through these so an empty list takes its heading
                with it instead of leaving a title over a void.
            -->
            <controls:CollectionHasItemsConverter x:Key="HasItems" />
            <controls:CollectionHasItemsConverter x:Key="HasNoItems" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
