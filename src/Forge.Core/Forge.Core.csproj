<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Forge.Domain\Forge.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Abstractions only - the ILogger contracts, no providers, no configuration, no host. That is
      what lets the file sink and its redaction live here, where they are unit-testable on a
      desktop, instead of in Forge.App where nothing can reach them without an emulator.

      FORGE001 permits this: the guard in src/Directory.Build.targets bans Microsoft.Maui.* and
      DevExpress.*, and this is neither.
    -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
