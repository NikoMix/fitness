<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Forge.Core\Forge.Core.csproj" />
    <ProjectReference Include="..\Forge.Domain\Forge.Domain.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <!--
      Sqlite.Core plus the SQLCipher bundle, never the plain Sqlite package. See the note in
      Directory.Packages.props: the wrong combination produces a silently unencrypted database,
      because PRAGMA key against stock SQLite is an unknown pragma and SQLite ignores those without
      error. DatabaseEncryptionTests reads the file header to make sure that cannot recur.
    -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite.Core" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" />
    <!-- Design-time only: scaffolds migrations. PrivateAssets keeps it out of the shipped app. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Content\exercise-catalogue.json" />
    <None Remove="Content\food-catalogue.json" />
    <None Remove="Content\recipe-catalogue.json" />
    <EmbeddedResource Include="Content\exercise-catalogue.json" />
    <EmbeddedResource Include="Content\food-catalogue.json" />
    <EmbeddedResource Include="Content\recipe-catalogue.json" />
  </ItemGroup>

</Project>
